# The base ISO is 6.6 GB and is fetched, not committed.
#
# Its checksum is pinned in base/CHECKSUMS so the build always verifies what it
# downloaded. Committing the image itself would make the repository unusable and
# is how "add the ISO" ends with a 6 GB git push that nobody can clone.

base/*.iso
base/*.iso.*
base/*.tmp

# Built images. These are outputs, not source: they are gigabytes each and
# are reproduced by tools/build-live.sh from the verified base ISO.
out/
*.iso

# Python bytecode. It was committed once, by accident, in a commit that was
# about wallpapers, and a .pyc checked into git is a stale one forever: it does
# not get regenerated when the .py changes, and nothing tells you which version
# of the source it was compiled from.
__pycache__/
*.py[co]

# brand/assets/preview-mark.png is generated by tools/make-brand.py for review
# and is not an input to anything. The wallpapers, the mark and the wordmark are
# generated but ARE committed: the build regenerates them anyway, and having
# them in the repository means a reviewer can look at the identity without
# running anything.
brand/assets/preview-mark.png
