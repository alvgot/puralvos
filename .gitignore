# The base ISO is 6.6 GB and is fetched, not committed.
#
# Its checksum is pinned in base/CHECKSUMS so the build always verifies what it
# downloaded. Committing the image itself would make the repository unusable and
# is how "add the ISO" ends with a 6 GB git push that nobody can clone.

base/*.iso
base/*.iso.*
base/*.tmp

# Built images. These are outputs, not source: they are gigabytes each and
# are reproduced by tools/build-live.sh from the verified base ISO.
out/
*.iso
