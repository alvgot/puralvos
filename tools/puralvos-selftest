#!/usr/bin/env bash
# puralvos-selftest - verify a PuralvOS image actually works, from the inside.
#
# Run inside the booted system, normally from /etc/boot.d/90-puralvos-selftest
# when the kernel was given puralvos.selftest=1. Everything it prints goes to
# the serial console, so the result can be read from a headless KVM run.
#
#   0  system    - the things an image needs before any app: buses, audio,
#                  network, the filesystem, the package database
#   1  inventory - every declared package is really installed and every menu
#                  entry points at a binary that exists
#   2  realtime  - can this machine actually do real time audio? This is the
#                  tier PuralvOS is judged on and the one that cannot be
#                  checked by looking at a healthy running desktop
#   3  branding  - is anything on this disk still Ubuntu's
#   4  launch    - really start each application in the running session,
#                  check a window appears, then close it
#
# Every result line is machine readable:
#   RESULT <tier> <PASS|FAIL|SLOW|SKIP> <name> <detail>
#
# and the run ends with one summary line, so a build can grep a single line
# and decide whether the image is good.
#
# Run it on the base as well as on PuralvOS. If Kdenlive misbehaves after
# stripping and the base was never measured, a day disappears blaming work
# that did not cause it.

# --------------------------------------------------------------------------
# output
# --------------------------------------------------------------------------
if [ -w /dev/ttyS0 ]; then
	OUT=/dev/ttyS0
else
	OUT=/dev/console
fi
say() { echo "$*" > "$OUT" 2>/dev/null; echo "$*" >&2; }

T0=$(date +%s)
say ""
say "########## PURALVOS SELFTEST BEGIN ##########"

PASS=0; FAIL=0; SLOW=0; SKIP=0
declare -a FAILED=()

result() {
	local tier=$1 status=$2 name=$3 detail=${4:-}
	say "RESULT $tier $status $name $detail"
	case "$status" in
		PASS) PASS=$((PASS+1)) ;;
		FAIL) FAIL=$((FAIL+1)); FAILED+=("$tier:$name $detail") ;;
		SLOW) SLOW=$((SLOW+1)); FAILED+=("$tier:$name slow: $detail") ;;
		SKIP) SKIP=$((SKIP+1)) ;;
	esac
}

# --------------------------------------------------------------------------
# environment
# --------------------------------------------------------------------------
# The user to test as. Both Alv and Puria need this to pass, so it is not
# hardcoded to one: whatever the installer created, or the live user if there
# is only one.
PurUser="${PURALVOS_USER:-}"
if [ -z "$PurUser" ]; then
	# loginctl's uid column is the FIRST field. The first version of this
	# line tested $3 — the LINGER column, which never contains "1000" — so
	# the "first user row" fallback always decided, and on a live boot the
	# unit starts at multi-user.target before SDDM has logged anybody in,
	# so there were no rows at all and the run fell through to the
	# hardcoded "ubuntu": a user that does not exist on a flavour ISO.
	# Every check after that tested a missing account, and the X wait
	# pointed an xauth at a home directory that was never created.
	#
	# The reliable fact is not loginctl: casper creates the live user with
	# uid 1000 (25adduser: "db_set passwd/user-uid 1000") under the name it
	# derives from .disk/info. getent asks the passwd database directly and
	# answers before any session exists, while loginctl is still consulted
	# first WHEN it has an answer, because on an installed system it names
	# the logged-in user even when that is not uid 1000.
	# prefer a real login user over the installer account
	PurUser=$(loginctl list-users --no-legend 2>/dev/null | awk '$1=="1000"{print $2; exit}')
	[ -z "$PurUser" ] && PurUser=$(getent passwd 1000 2>/dev/null | cut -d: -f1)
	[ -z "$PurUser" ] && PurUser=$(loginctl list-users --no-legend 2>/dev/null | awk 'NF{print $2; exit}')
fi
[ -z "$PurUser" ] && PurUser=ubuntu
PurHome=$(getent passwd "$PurUser" 2>/dev/null | cut -d: -f6)
[ -z "$PurHome" ] && PurHome="/home/$PurUser"
PurUid=$(id -u "$PurUser" 2>/dev/null || echo 1000)
PurGid=$(id -g "$PurUser" 2>/dev/null || echo 1000)

# Where the session's bus and X authority live. A normal logind session puts
# them in /run/user/<uid>. On the live image no seat may be registered, in
# which case the bus is somewhere else entirely, so prefer the standard place
# and fall back rather than hardcoding either.
SessionDir=/run/user/$PurUid
if [ ! -S "$SessionDir/bus" ]; then
	for cand in /run/live/session /run/user/$(id -u) ; do
		[ -S "$cand/bus" ] && { SessionDir=$cand; break; }
	done
fi

# DISPLAY and XAUTHORITY, discovered rather than assumed, and re-discovered
# while waiting for the session to appear.
#
# DISPLAY was hardcoded to :0 once and the desktop check reported "no X
# server after 240s" on an image whose session was on :1, because a second
# display manager or a leftover greeter had taken :0. The test then reported
# the desktop as dead when the desktop was running perfectly one display
# over. So the session process's own environment is the source of truth:
# a PID, not a UID (/proc/<uid>/environ does not exist, and the first
# attempt at this read nothing at all), and plasmashell or kwin because
# they are what this test already waits for.
#
# XAUTHORITY rides along because guessing its path fails in practice: SDDM
# does not write /run/user/<uid>/Xauthority or the user's ~/.Xauthority, it
# writes /run/user/<uid>/xauth_XXXXXX and points the session environment at
# that. The first boot with this test enabled waited out the full 240
# seconds and would have failed every desktop check against a live desktop,
# all because xdpyinfo was run with an XAUTHORITY path that did not exist.
#
# Both are probed in one function so the wait loop can re-run it: the unit
# starts at multi-user.target, and on a cold VM the session sometimes
# appears seconds or minutes after the test's first look.
DisPlay=""
SessXAUTH=""
SessBus=""
probe_session_env() {
	local pid env_dump
	DisPlay=""
	SessXAUTH=""
	SessBus=""
	for pid in $(pgrep -u "$PurUid" -x plasmashell 2>/dev/null; \
	             pgrep -u "$PurUid" -x kwin_x11 2>/dev/null; \
	             pgrep -u "$PurUid" -x kwin_wayland 2>/dev/null); do
		[ -r "/proc/$pid/environ" ] || continue
		env_dump=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null)
		[ -n "$DisPlay" ] || DisPlay=$(printf '%s\n' "$env_dump" |
			sed -n 's/^DISPLAY=//p' | head -1)
		[ -n "$SessXAUTH" ] || SessXAUTH=$(printf '%s\n' "$env_dump" |
			sed -n 's/^XAUTHORITY=//p' | head -1)
		[ -n "$SessBus" ] || SessBus=$(printf '%s\n' "$env_dump" |
			sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p' | head -1)
		[ -n "$DisPlay" ] && [ -n "$SessXAUTH" ] && break
	done
}
resolve_session() {
	local xf
	if [ -z "$DisPlay" ]; then
		DisPlay=$(loginctl show-session "${PurUid}" -p Display --value 2>/dev/null | head -1)
		[ -n "$DisPlay" ] && case "$DisPlay" in :*) ;; *) DisPlay=":$DisPlay" ;; esac
	fi
	# The bus can exist before any probeable session process does; prefer
	# the one the found session's own processes point at.
	if [ -n "$SessBus" ] && [ -S "${SessBus#unix:path=}" ]; then
		SessionDir="${SessBus#unix:path=}"
		SessionDir="${SessionDir%/*}"
	elif [ ! -S "$SessionDir/bus" ] && [ -S "/run/user/$PurUid/bus" ]; then
		SessionDir="/run/user/$PurUid"
	fi
	if [ -n "$SessXAUTH" ] && [ -r "$SessXAUTH" ]; then
		XAuth="$SessXAUTH"
		return
	fi
	if [ -r "$SessionDir/Xauthority" ]; then
		XAuth="$SessionDir/Xauthority"
		return
	fi
	for xf in "$SessionDir"/xauth_*; do
		[ -r "$xf" ] && { XAuth="$xf"; return; }
	done
	XAuth="$PurHome/.Xauthority"
}
probe_session_env
resolve_session
[ -n "$DisPlay" ] || DisPlay=":0 (assumed: no session process to ask)"
say "INFO display=$DisPlay session=$SessionDir xauth=$XAuth"

if [ -c /dev/ttyS0 ]; then
	chmod 0660 /dev/ttyS0 2>/dev/null
fi

LdyLocale="$(sed -n 's/^LANG=\(.*\)$/\1/p' /etc/default/locale 2>/dev/null | head -1)"
[ -z "$LdyLocale" ] && LdyLocale="C.UTF-8"

# Run a command the way the menu would.
#
# The desktop is the user's session, so applications have to be tested as the
# user: Kdenlive and VLC both refuse to run as root, and testing them as root
# would report two perfectly good applications as broken.
as_desktop() {
	setpriv --reuid="$PurUid" --regid="$PurGid" --init-groups \
		env \
		HOME="$PurHome" USER="$PurUser" LOGNAME="$PurUser" \
		SHELL=/bin/bash \
		PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
		DISPLAY="$DisPlay" XAUTHORITY="$XAuth" \
		XDG_RUNTIME_DIR="$SessionDir" \
		DBUS_SESSION_BUS_ADDRESS="unix:path=$SessionDir/bus" \
		XDG_SESSION_TYPE=x11 XDG_SESSION_CLASS=user \
		XDG_SESSION_DESKTOP=KDE XDG_CURRENT_DESKTOP=KDE \
		DESKTOP_SESSION=plasma \
		XDG_CONFIG_DIRS="/etc/xdg:$PurHome/.config" \
		XDG_DATA_DIRS="/usr/local/share:/usr/share:$PurHome/.local/share" \
		XDG_CACHE_HOME="$PurHome/.cache" \
		XDG_CONFIG_HOME="$PurHome/.config" \
		XDG_DATA_HOME="$PurHome/.local/share" \
		LANG="$LdyLocale" LC_ALL="$LdyLocale" LANGUAGE=en_US:en \
		"$@"
}

say "INFO kernel=$(uname -r)"
say "INFO uname=$(uname -a)"
say "INFO distro=$(sed -n 's/^PRETTY_NAME="\(.*\)"$/\1/p' /etc/os-release 2>/dev/null | head -1)"
say "INFO user=$PurUser uid=$PurUid home=$PurHome"
say "INFO groups=$(id -nG "$PurUser" 2>/dev/null | tr ' ' ',')"
say "INFO uptime=$(cut -d' ' -f1 /proc/uptime)s"

# --------------------------------------------------------------------------
# wait for the desktop
# --------------------------------------------------------------------------
say "INFO waiting for the X server"
# Overridable so the tool can be smoke tested somewhere that has no desktop at
# all, without waiting out the full patience of a real boot.
XWAIT=${XWAIT:-240}
XUP=0
for _ in $(seq 1 "$XWAIT"); do
	# Re-probe: on a cold boot the session appears after this unit starts,
	# and each pass may be the first one that can see plasmashell, its
	# DISPLAY and its real XAUTHORITY. Loginctl can lag the session by a
	# beat even after that, so anything found there is recomputed too.
	probe_session_env
	resolve_session
	[ -n "$DisPlay" ] || DisPlay=":0 (assumed: no session process to ask)"
	if as_desktop xdpyinfo >/dev/null 2>&1; then XUP=1; break; fi
	sleep 1
done

dump() {
	local tag=$1 file=$2 n=${3:-60}
	say "--- $tag ($file)"
	if [ -r "$file" ]; then
		tail -n "$n" "$file" 2>/dev/null | tr -d '\r' |
			while IFS= read -r l; do say "$tag $l"; done
	else
		say "$tag <missing>"
	fi
}

if [ "$XUP" != 1 ]; then
	# Do not exit here. A boot with no desktop is the moment you most want the
	# kernel, the real time configuration and the branding state, and those
	# need no X server at all. Only tier 4 genuinely cannot run without one, so
	# record the failure, spill the diagnostics, carry on, and let tier 4 skip
	# itself. Exiting first would throw away the answers to the questions this
	# tool exists to answer.
	#
	# The two things that distinguish "no desktop" from "no display server" are
	# reported first, because they have completely different causes and this
	# failure message used to be the same for all three:
	#
	#   no greeter at all      sddm is not running; the session never started
	#   greeter, no session    autologin is not configured, so the machine is
	#                          sitting at a login prompt that nobody will answer
	#   session, no X          the session started and the display server failed
	#                          inside it; Xorg.0.log has the reason
	result tier0 FAIL "desktop-started" "no X server on $DisPlay after ${XWAIT}s"
	if pgrep -x sddm >/dev/null 2>&1; then
		say "INFO sddm is running, so the display manager is up"
		if pgrep -x sddm-greeter-qt >/dev/null 2>&1; then
			say "INFO the greeter is showing and no session has started:"
			say "INFO autologin is not configured, so nothing logs in by itself"
			result tier0 FAIL "desktop-autologin" \
				"a greeter is waiting for a login that will never come; the live session is not logged in"
		else
			result tier0 SLOW "desktop-autologin" \
				"sddm is up and no greeter is showing; a session may be starting"
		fi
	else
		result tier0 FAIL "desktop-displaymanager" \
			"sddm is not running at all; check: systemctl status sddm"
	fi
	dump SESSIONLOG "$PurHome/.xsession-plasma.log" 80
	dump XORGLOG /var/log/Xorg.0.log 60
	say "--- process list"
	ps -eo pid,user,comm --sort=pid 2>/dev/null |
		while IFS= read -r l; do say "PS $l"; done
else
	result tier0 PASS "desktop-started" "X server up on $DisPlay at $(cut -d' ' -f1 /proc/uptime)s"
fi

# X answering does not mean the desktop is up: kwin and plasmashell come after
# it. Give them a moment, otherwise this reports a perfectly healthy boot as a
# dead desktop.
#
# Either compositor, for the same reason the tier 0 check below takes either:
# kwin_x11 on X11, kwin_wayland on Wayland.
for _ in $(seq 1 60); do
	pgrep -x plasmashell >/dev/null 2>&1 &&
		{ pgrep -x kwin_x11 >/dev/null 2>&1 || pgrep -x kwin_wayland >/dev/null 2>&1; } &&
		break
	sleep 1
done

# ==========================================================================
# TIER 0 - the system itself
# ==========================================================================
say "--- tier 0: system"

[ -S "${SessionDir}/bus" ] \
	&& result tier0 PASS "dbus-session-bus" \
	|| result tier0 FAIL "dbus-session-bus" "no socket at ${SessionDir}/bus"

# The bus process, under whichever implementation is running it.
#
# Ubuntu 26.10 moved both buses to dbus-broker; 26.04 ran dbus-daemon. The
# desktop and every application depend on the bus, not on which implementation
# serves it, and on 26.10 the old check reported a healthy bus as missing.
# Accept either, and say which one answered.
if pgrep -x dbus-broker >/dev/null 2>&1; then
	result tier0 PASS "dbus-daemon-running" "dbus-broker"
elif pgrep -x dbus-daemon >/dev/null 2>&1; then
	result tier0 PASS "dbus-daemon-running" "dbus-daemon"
else
	result tier0 FAIL "dbus-daemon-running" \
		"no dbus-daemon or dbus-broker process"
fi

# The compositor, under whichever name it is running.
#
# kwin_x11 for an X11 session and kwin_wayland for a Wayland one. The old check
# looked for kwin_x11 only, so on a Wayland session — which is what the base
# image's own greeter starts — it reported the compositor as not running while
# it was, and tier 0 read as a dead desktop. Accept either, and say which.
if pgrep -u "$PurUid" -x kwin_x11 >/dev/null 2>&1; then
	result tier0 PASS "desktop-kwin" "kwin_x11 running as ${PurUser}"
elif pgrep -u "$PurUid" -x kwin_wayland >/dev/null 2>&1; then
	result tier0 PASS "desktop-kwin" "kwin_wayland running as ${PurUser}"
else
	result tier0 FAIL "desktop-kwin" \
		"no kwin_x11 or kwin_wayland as ${PurUser}, the desktop cannot be up"
fi

pgrep -u "$PurUid" -x plasmashell >/dev/null 2>&1 \
	&& result tier0 PASS "desktop-plasmashell" \
	|| result tier0 FAIL "desktop-plasmashell" \
		"not running as ${PurUser}, the desktop cannot be up"

# The desktop must belong to the user, not to root. When the session ran as
# root the whole home directory filled up with root-owned files.
HomeOwner="$(stat -c %u "$PurHome" 2>/dev/null)"
if [ "$HomeOwner" = "$PurUid" ]; then
	result tier0 PASS "home-owned-by-user"
else
	result tier0 FAIL "home-owned-by-user" "$PurHome is owned by uid $HomeOwner, expected $PurUid"
fi

# No process may have died: a crash loop still leaves one running.
ErrCount=$(dmesg 2>/dev/null | grep -ciE "segfault|general protection fault" || true)
if [ "${ErrCount:-0}" -gt 0 ]; then
	result tier0 SLOW "kernel-crashes" "$ErrCount segfault/gpfs messages in dmesg"
else
	result tier0 PASS "kernel-crashes"
fi

# Audio. PipeWire without its session manager is installed but silent, which
# is exactly the kind of thing that looks fine and is not.
#
# Both start from the session, not from an init script, so at the moment the
# desktop is reported up they may not have been launched yet. Checking once,
# here, reported "no pipewire process" on a system where the daemon was running
# perfectly a minute later. Wait for them instead: a check that cries wolf is
# worse than no check, because it trains you to ignore the one that matters.
wait_for_proc() {
	# wait_for_proc <process name> <seconds to wait>
	local _n="$1" _left="${2:-40}"
	while [ "${_left}" -gt 0 ]; do
		pgrep -x "${_n}" >/dev/null 2>&1 && return 0
		sleep 1
		_left=$((_left - 1))
	done
	return 1
}

if wait_for_proc pipewire 40; then
	result tier0 PASS "pipewire-running"
else
	result tier0 FAIL "pipewire-running" "no pipewire process after 40s"
fi

if command -v wireplumber >/dev/null 2>&1; then
	if wait_for_proc wireplumber 40; then
		result tier0 PASS "wireplumber-running"
	else
		result tier0 FAIL "wireplumber-running" "installed but not running after 40s"
	fi
else
	result tier0 FAIL "wireplumber-installed" \
		"PipeWire has no session manager, nothing will route audio"
fi

# An audio mixer with no playback device has nothing to show, so record what
# the sound stack actually found. On a machine with real hardware there is a
# sink here; under a bare emulator there may be none, which is not a fault in
# the image but explains any mixer that opens no window.
if command -v pactl >/dev/null 2>&1; then
	NSinks="$(as_desktop pactl list short sinks 2>/dev/null | wc -l)"
	if [ "${NSinks:-0}" -gt 0 ]; then
		result tier0 PASS "audio-sinks" "$NSinks playback sink(s)"
	else
		result tier0 SLOW "audio-sinks" \
			"no playback sink, the machine or the emulator has no sound card"
	fi
else
	result tier0 SKIP "audio-sinks" "pactl not installed"
fi

# The package database has to agree with the filesystem.
Npkg=$(dpkg-query -f '${binary:Package}\n' -W 2>/dev/null | wc -l)
say "INFO dpkg knows about $Npkg packages"
if [ "$Npkg" -lt 500 ]; then
	result tier0 FAIL "dpkg-database" "only $Npkg packages known, the filesystem is broken"
else
	result tier0 PASS "dpkg-database" "$Npkg packages"
fi

# The curated set is deliberately much smaller than the base's 3362, so record
# the number. This is also the measurement that makes the strip-down a number
# rather than a feeling: compare against docs/BASELINE.md.
grep -qE ' / .*(overlay|squashfs)' /proc/mounts \
	&& result tier0 PASS "rootfs-live" \
	|| result tier0 PASS "rootfs-live" "not a live/overlay mount, this is an installed system"

touch "${PurHome}/.selftest-write" 2>/dev/null \
	&& { rm -f "${PurHome}/.selftest-write"; result tier0 PASS "home-writable"; } \
	|| result tier0 FAIL "home-writable" "cannot write to $PurHome"

if ping -c1 -W2 9.9.9.9 >/dev/null 2>&1; then
	result tier0 PASS "network-reachability"
elif [ -n "$(ip -o addr show scope global 2>/dev/null)" ]; then
	result tier0 SLOW "network-reachability" "interface up but no outbound ping"
else
	result tier0 FAIL "network-reachability" "no global interface"
fi

# ==========================================================================
# TIER 2 - real time  (the tier this machine is judged on)
# ==========================================================================
say "--- tier 2: realtime"
say "INFO a workstation can install perfectly, have every application present,"
say "INFO open its mixer, and still glitch under load. This is the tier that"
say "INFO catches that, and none of it is visible from a running desktop."

# --- the kernel ------------------------------------------------------------
# This has to be PREEMPT_RT. Not linux-lowlatency, which is the generic kernel
# with boot arguments, and not whatever happens to be booted. The stock Ubuntu
# Studio ISO carries linux-generic and no RT kernel at all, so a live image
# that does not add this at build time is a generic kernel wearing the name.
Kver="$(uname -v)"
if printf '%s' "$Kver" | grep -qiE 'rt|realtime'; then
	result tier2 PASS "kernel-is-realtime" "$Kver"
else
	result tier2 FAIL "kernel-is-realtime" \
		"booted '$Kver', which is not PREEMPT_RT; audio cannot be real time on this kernel"
fi

# The kernel package, separately: a kernel string can be inherited from a
# package that was replaced, and this catches that.
Kpkg=$(dpkg-query -W -f='${Package} ${Version}\n' 'linux-image-*' 2>/dev/null |
	grep -E '^linux-image-(realtime|lowlatency|generic|hwe)' | head -1)
say "INFO kernel package: ${Kpkg:-unknown}"

# --- RT priority -----------------------------------------------------------
# Checked as the user, through the same limits mechanism the desktop gets.
# Reading the limits file is not enough on its own: the file can exist, be
# correct, and still not apply if it was never read by a PAM stack that
# matters. The number is what counts.
#
# Measured through a PAM SESSION, not through as_desktop.
#
# That is the whole reason this check reported FAIL on an image that was
# correct. pam_limits is a PAM *session* module: it applies limits when a
# session is opened. setpriv does not open one. It re-execs with different
# credentials and inherits the limits of the process that called it, which is
# this test running as root. So
#
#     as_desktop bash -c 'ulimit -r'
#
# can only ever print 0, on a perfectly configured image and a badly configured
# one alike, because it never consults /etc/security/limits.d at all. A check
# that cannot pass is a check that gets ignored, and this one had been ignored.
#
# su does open a session: /etc/pam.d/su carries `session required
# pam_limits.so`, and so do login, sddm and sddm-autologin. So the honest
# measurement is a real login as the user, and that is what this does.
pam_ulimit() {
	# pam_ulimit <shell keyword>: as the user, through PAM.
	su - "$PurUser" -c "ulimit -$1" 2>/dev/null | tr -d ' \r'
}

RTprio=$(pam_ulimit r)
case "$RTprio" in
	''|*[!0-9]*)
		result tier2 FAIL "rtprio-limit" \
			"could not read rtprio through a PAM session as $PurUser (got '$RTprio')" ;;
	*)
		if [ "$RTprio" -ge 90 ]; then
			result tier2 PASS "rtprio-limit" "rtprio $RTprio in a real login session"
		elif [ "$RTprio" -eq 0 ]; then
			result tier2 FAIL "rtprio-limit" \
				"rtprio is 0 in a real login session, audio runs at normal priority and WILL glitch under load"
		else
			result tier2 SLOW "rtprio-limit" "rtprio $RTprio, expected 95"
		fi
		;;
esac

# memlock: JACK maps large locked regions and is refused without this
MEMlock=$(pam_ulimit l)
if [ "$MEMlock" = "unlimited" ] || [ "${MEMlock:-0}" -ge 1048576 ] 2>/dev/null; then
	result tier2 PASS "memlock-limit" "memlock $MEMlock in a real login session"
else
	result tier2 FAIL "memlock-limit" \
		"memlock is '$MEMlock' in a real login session, JACK will fail to lock memory it needs"
fi

# And what the desktop's own processes actually got, which is the number that
# matters. pipewire holds the audio threads, so its limits decide whether JACK
# can lock memory.
#
# Read from /proc/<pid>/limits rather than by asking pipewire anything: it
# works whether or not the daemon has finished starting, needs no pipewire
# tooling, and reports the kernel's own view of the process.
pwpid_early=$(pgrep -u "$PurUid" -x pipewire 2>/dev/null | head -1)
if [ -n "$pwpid_early" ] && [ -r "/proc/$pwpid_early/limits" ]; then
	# The kernel spells this field "Max realtime priority" — no hyphen. The
	# hyphenated pattern matched nothing, printed nothing, defaulted to 0 and
	# failed the check on every boot of every image, correct ones included.
	proc_rt=$(awk '/^Max realtime priority/ {print $NF}' "/proc/$pwpid_early/limits")
	proc_ml=$(awk '/^Max locked memory/ {print $(NF-3), $(NF-2), $(NF-1), $NF}' "/proc/$pwpid_early/limits")
	if [ "${proc_rt:-0}" -ge 90 ]; then
		result tier2 PASS "pipewire-rlimits" \
			"pipewire runs with rtprio $proc_rt and memlock $proc_ml"
	else
		# RLIMIT_RTPRIO, read by the kernel. memlock can still show unlimited
		# here — pipewire.service sets LimitMEMLOCK itself — but an rtprio of
		# 0 means the limits.d grants are not applying to the daemon, and
		# JACK started in a user session would be refused real time too.
		result tier2 FAIL "pipewire-rlimits" \
			"RLIMIT_RTPRIO is ${proc_rt:-0} for pipewire (memlock $proc_ml): the limits.d grants are not applying; check user-in-audio-group above"
	fi
else
	result tier2 SKIP "pipewire-rlimits" "pipewire is not running yet, cannot read its limits"
fi

# The limits file itself, so the diagnosis is obvious when the numbers are
# wrong. Its absence is the single most common cause of both failures above.
# The four fields, space separated, and NO equals sign. limits.conf is parsed
# by pam_limits as "<domain> <type> <item> <value>", so Ubuntu's own file,
#
#     @audio   -  rtprio     95
#
# is correct and this check used to require 'rtprio = 95', a form nothing ever
# writes. It reported FAIL on an image carrying Ubuntu Studio's own limits file
# verbatim, which is the worst kind of wrong: it sends you looking for a
# packaging bug that is not there.
LIMITS=/etc/security/limits.d/30-ubuntustudio-audio.conf
if [ -r "$LIMITS" ]; then
	# domain, item, lowest acceptable numeric value
	limits_grants() {
		awk -v dom="$1" -v item="$2" -v min="$3" '
			/^[[:space:]]*#/ { next }
			NF >= 4 && $1 == dom && $3 == item && $4 + 0 >= min + 0 { found = 1 }
			END { exit(found ? 0 : 1) }
		' "$LIMITS"
	}
	missing=""
	limits_grants '@audio'    rtprio  90 || missing="$missing @audio-rtprio"
	# memlock is checked as a word below, not through limits_grants: "unlimited"
	# is not a number and $4 + 0 makes it 0, so a numeric comparison against a
	# minimum of 0 passes for a line that is not there at all. There was a
	# `limits_grants '@audio' memlock 0 || true` line here doing exactly that.
	# It asserted nothing, which is worse than not asserting: it looked like the
	# memlock grant was being checked.
	grep -qE '^[[:space:]]*@audio[[:space:]]+[^[:space:]]+[[:space:]]+memlock[[:space:]]+unlimited' "$LIMITS" \
		|| missing="$missing @audio-memlock"
	limits_grants '@pipewire' rtprio  90 || missing="$missing @pipewire-rtprio"
	grep -qE '^[[:space:]]*@pipewire[[:space:]]+[^[:space:]]+[[:space:]]+memlock[[:space:]]+unlimited' "$LIMITS" \
		|| missing="$missing @pipewire-memlock"
	if [ -z "$missing" ]; then
		result tier2 PASS "limits-file" "grants rtprio 95 and memlock unlimited to @audio and @pipewire"
	else
		result tier2 FAIL "limits-file" "no grant for:$missing"
	fi
else
	result tier2 FAIL "limits-file" \
		"$LIMITS is missing; ubuntustudio-installer-helper's 'fix' step never ran"
fi

# The user must be in the audio group.
#
# `id -nG | tr | grep -qx` would work, except that grep -q exits on the first
# match and tr can then take SIGPIPE, and this script runs under `set -o
# pipefail`. The pipeline's status becomes 128+13 instead of 0 and the check
# reports the user is NOT in the audio group — on an image where they are, and
# with the whole real time audio tier depending on the answer.
#
# The pipeline result is captured first, so nothing in it is ever killed early,
# and the status read afterwards is grep's own.
# The variable must NOT be called GROUPS. That name is special in bash — it
# holds the CURRENT user's groups as an array, and assignments to it are
# silently ignored. The check runs as root, so every report read "groups: 0"
# (root's group) no matter what id said, on an image where `id puralvos`
# showed 29(audio) and the INFO line at the top of this script printed the
# real group list from the same command. It contradicted rtprio-limit PASS
# for months; the failure report's raw id/getent evidence is what proved the
# check wrong rather than the image. Keep that evidence in the message — it
# costs one line and it settled the argument.
UGNAMES=$(id -nG "$PurUser" 2>/dev/null)
if printf '%s\n' "$UGNAMES" | tr ' ' '\n' | grep -qx audio; then
	result tier2 PASS "user-in-audio-group"
else
	result tier2 FAIL "user-in-audio-group" \
		"$PurUser is not in the audio group (id -nG: '${UGNAMES:-unknown}'; id: $(id "$PurUser" 2>/dev/null | tr -s ' ' | cut -c1-150); getent group audio: $(getent group audio 2>/dev/null | cut -c1-90))"
fi

# --- the tuning that is not a package --------------------------------------
# Report-only checks. The first one changes boot and battery behaviour enough
# to be a decision, so it is SLOW when wrong, not FAIL.

GOV=""
for c in /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor; do
	[ -r "$c" ] && GOV=$(cat "$c" 2>/dev/null)
done
if [ -z "$GOV" ]; then
	result tier2 SKIP "cpu-governor" "no cpufreq driver on this machine"
elif [ "$GOV" = "performance" ]; then
	result tier2 PASS "cpu-governor" "$GOV"
else
	result tier2 SLOW "cpu-governor" \
		"$GOV; performance is what real time audio wants, see docs/PERFORMANCE.md"
fi

SWAP=$(sed -n 's/^vm\.swappiness=\s*\([0-9]*\).*/\1/p' /proc/sys/vm/swappiness 2>/dev/null | head -1)
if [ -z "$SWAP" ]; then
	result tier2 SKIP "swappiness" "cannot read /proc/sys/vm/swappiness"
elif [ "$SWAP" -le 10 ]; then
	result tier2 PASS "swappiness" "$SWAP"
else
	result tier2 SLOW "swappiness" "$SWAP, a session should not swap"
fi

# isolcpus/nohz_full are in the kernel command line on the installed system.
# Reported, not judged: the right value depends on the machine's core count,
# and a wrong guess here is worse than leaving it off.
CMDLINE=$(tr '\0' ' ' < /proc/cmdline 2>/dev/null)
say "INFO cmdline: $CMDLINE"
for opt in isolcpus nohz_full threadirqs; do
	if printf '%s' "$CMDLINE" | grep -qw "$opt"; then
		result tier2 PASS "cmdline-$opt"
	else
		result tier2 SKIP "cmdline-$opt" "not on the kernel command line"
	fi
done

# USB autosuspend on the audio interface: the most common cause of "it
# glitches when I move the mouse". A rule file is checked rather than the
# runtime state, because by the time this runs the interface may be idle.
if ls /etc/udev/rules.d/*puralvos* /etc/udev/rules.d/*audio* >/dev/null 2>&1; then
	result tier2 PASS "udev-audio-rules" \
		"$(ls /etc/udev/rules.d/ | grep -cE 'puralvos|audio') rule file(s)"
else
	result tier2 SLOW "udev-audio-rules" \
		"no audio udev rule; USB autosuspend will still glitch the interface"
fi

# --- what the audio daemon is actually running at --------------------------
# The strongest evidence available without hardware: a live PipeWire thread
# holding a real-time policy.
pwpid=$(pgrep -u "$PurUid" -x pipewire 2>/dev/null | head -1)
if [ -z "$pwpid" ]; then
	result tier2 SKIP "pipewire-rt-policy" "pipewire is not running yet"
else
	# Which thread holds real time, and at what priority.
	#
	# Two wrong expectations lived here. `chrt -p PID` reads the MAIN thread,
	# and PipeWire's main thread is SCHED_OTHER by design — the daemon drops
	# privileges and hands real time to its data threads through module-rt.
	# And the value is not 95: PipeWire requests `rt.prio = 20` (module-rt's
	# stock config), and that is the ceiling rtkit grants to a user daemon
	# anyway. The 95 from limits.d is for JACK clients scheduling themselves
	# directly. So the test is "does a data thread ride real time at all",
	# and the priority is reported rather than judged against 95.
	RTT=$(ps -L -p "$pwpid" -o rtprio=,comm= 2>/dev/null)
	RTHI=$(printf '%s' "$RTT" | awk '$1 + 0 >= 1 {print $1, $2; exit}')
	if [ -n "$RTHI" ]; then
		NRTHI=$(printf '%s' "$RTT" | awk '$1 + 0 >= 1' | wc -l)
		result tier2 PASS "pipewire-rt-policy" \
			"$NRTHI thread(s) real time, first: $RTHI (rtkit grants 20; limits.d 95 is for JACK)"
	else
		result tier2 FAIL "pipewire-rt-policy" \
			"no pipewire thread is real time; threads (rtprio, name): $(printf '%s' "$RTT" | tr '\n' ';')"
	fi
fi

# --- xruns -----------------------------------------------------------------
# Zero xruns is the target in docs/PERFORMANCE.md. It can only be measured
# with an audio device and JACK actually running, which needs hardware this
# harness may not have. Skipped rather than faked: a self test that reports a
# pass it did not earn is how a broken workstation ships.
if command -v jackd >/dev/null 2>&1 && command -v jack_control >/dev/null 2>&1; then
	if [ "${NSinks:-0}" -gt 0 ] || [ -e /dev/snd ]; then
		result tier2 SKIP "jack-xruns" \
			"needs a JACK server running with a real device; run puralvos-xrun-bench on the workstation"
	else
		result tier2 SKIP "jack-xruns" "no audio device, JACK cannot start here"
	fi
else
	result tier2 SKIP "jack-xruns" "jackd not installed"
fi

# ==========================================================================
# TIER 3 - branding
# ==========================================================================
say "--- tier 3: branding"
say "INFO Ubuntu and Ubuntu Studio are Canonical trademarks and this image is"
say "INFO neither. Anything still carrying their name is a defect."

# os-release first: it is what every tool reports the system as.
OSNAME=$(sed -n 's/^NAME="\(.*\)"$/\1/p' /etc/os-release 2>/dev/null | head -1)
if printf '%s' "$OSNAME" | grep -qi puralvos; then
	result tier3 PASS "os-release-name" "$OSNAME"
else
	result tier3 FAIL "os-release-name" "NAME='$OSNAME', should be PuralvOS"
fi

# Ubuntu Studio is the trademark that has to be gone. "Ubuntu" as a word is not,
# and cannot be: PuralvOS is a derivative of Ubuntu Studio, ID_LIKE=ubuntu is
# what keeps apt and every Ubuntu package treating this as an Ubuntu system,
# and UBUNTU_CODENAME is what keeps version-locked dependencies resolving.
# Remove either and the product stops working as a derivative.
#
# So the check is for "Ubuntu Studio" specifically, in any of the spellings it
# appears in, and not for the substring "ubuntu". The old check was
# `grep -qi ubuntu /etc/os-release`, which fails on ID_LIKE="ubuntu" on a
# perfectly rebranded image, and had done so on every boot of every build.
# A branding check that cannot pass is a branding check nobody reads.
if grep -qiE 'ubuntu[ _-]?studio' /etc/os-release 2>/dev/null; then
	result tier3 FAIL "os-release-not-ubuntu-studio" \
		"$(grep -iE 'ubuntu[ _-]?studio' /etc/os-release | tr '\n' ' ' | cut -c1-120)"
else
	result tier3 PASS "os-release-not-ubuntu-studio" \
		"no Ubuntu Studio string; ID_LIKE and UBUNTU_CODENAME are kept deliberately, see README.md"
fi

# The ISO's own label. Only present on a live image.
#
# On a casper live boot the file lives on the mounted ISO under /cdrom, not
# in the root filesystem; reading only /.disk/info missed it entirely. The
# stock image mounts its own ISO at /cdrom — that is also where the casper
# scripts read user-setup defaults from — so both locations are checked.
DISKTXT=""
for f in /.disk/info /cdrom/.disk/info; do
	if [ -r "$f" ]; then
		DISKTXT=$(cat "$f" 2>/dev/null)
		break
	fi
done
if [ -n "$DISKTXT" ]; then
	if printf '%s' "$DISKTXT" | grep -qi puralvos; then
		result tier3 PASS "iso-label" "$DISKTXT"
	else
		result tier3 FAIL "iso-label" "$DISKTXT"
	fi
else
	result tier3 SKIP "iso-label" "not a live image"
fi

# Wallpapers that are still Canonical's.
#
# find -type f, over both directories, and the count is reported with the paths
# when it is not zero. The old version reported a bare number, which is the
# worst kind of failure report: "3 file(s) still say Ubuntu" and no indication
# of which three, on a machine with a hundred wallpapers in it.
UBUWALL_LIST=$(for d in /usr/share/backgrounds /usr/share/wallpapers; do
	[ -d "$d" ] || continue
	find "$d" \( -type f -o -type l \) \
		\( -iname '*ubuntu*' -o -iname '*studio*' \) 2>/dev/null
done)
UBUWALL=$(printf '%s' "$UBUWALL_LIST" | grep -c . )
PURWALL=$(find /usr/share/backgrounds -type f -iname '*puralvos*' 2>/dev/null | wc -l)
if [ "$PURWALL" -gt 0 ]; then
	result tier3 PASS "puralvos-wallpapers" "$PURWALL file(s) installed"
else
	result tier3 FAIL "puralvos-wallpapers" "none installed"
fi
if [ "$UBUWALL" -gt 0 ]; then
	result tier3 FAIL "ubuntu-wallpapers-remain" \
		"$UBUWALL file(s) still say Ubuntu or Ubuntu Studio: $(printf '%s' "$UBUWALL_LIST" | tr '\n' ' ' | cut -c1-160)"
else
	result tier3 PASS "ubuntu-wallpapers-remain"
fi

# Splash and login screens.
#
# Two things have to be true, and the old check only asked for one. It looked
# for a theme DIRECTORY and reported SLOW when there was none, which is right,
# but a directory that exists and is never selected would have passed it. So
# the theme has to exist AND be the one the system will actually use.
#
# Presence:
if [ -d /usr/share/plymouth/themes/puralvos ]; then
	result tier3 PASS "boot-splash-theme" "/usr/share/plymouth/themes/puralvos"
else
	result tier3 SLOW "boot-splash-theme" \
		"no PuralvOS plymouth theme; Ubuntu Studio's is installed instead"
fi
# Selection. plymouthd reads /etc/plymouth/plymouthd.default, and that is the
# file that decides what is on screen during boot.
PLY=$(sed -n 's/^PLYMOUTH_THEME_NAME=//p' /etc/plymouth/plymouthd.default 2>/dev/null | head -1)
if [ "$PLY" = "puralvos" ]; then
	result tier3 PASS "boot-splash-active" "plymouthd.default selects '$PLY'"
elif [ -n "$PLY" ]; then
	result tier3 FAIL "boot-splash-active" "plymouthd.default selects '$PLY', not puralvos"
else
	result tier3 SLOW "boot-splash-active" \
		"/etc/plymouth/plymouthd.default does not select a theme; the splash is whatever plymouth defaults to"
fi

if [ -d /usr/share/sddm/themes/puralvos ]; then
	result tier3 PASS "login-screen-theme" "/usr/share/sddm/themes/puralvos"
else
	result tier3 SLOW "login-screen-theme" "no PuralvOS SDDM theme"
fi
# Selection. SDDM reads Current= from its config directory.
SDDM_THEME_NAME=$(cat /etc/sddm.conf.d/*theme*.conf 2>/dev/null |
	sed -n 's/^Current=//p' | head -1)
if [ "$SDDM_THEME_NAME" = "puralvos" ]; then
	result tier3 PASS "login-screen-active" "sddm selects '$SDDM_THEME_NAME'"
elif [ -n "$SDDM_THEME_NAME" ]; then
	result tier3 FAIL "login-screen-active" "sddm selects '$SDDM_THEME_NAME', not puralvos"
else
	result tier3 SLOW "login-screen-active" "no sddm theme selection found; the greeter uses its default"
fi

# Anything left anywhere that claims to be the boot menu or the installer.
# The failure names the files: a count alone has already cost a boot spent
# hunting for one file nobody could identify.
GRUBSTILL=$(grep -rlisE 'ubuntu[ -]?studio' /boot/grub /EFI/ubuntu 2>/dev/null)
NGRUBSTILL=$(printf '%s' "$GRUBSTILL" | grep -c . )
if [ "$NGRUBSTILL" -eq 0 ]; then
	result tier3 PASS "grub-menus"
else
	result tier3 FAIL "grub-menus" \
		"$NGRUBSTILL file(s) still say Ubuntu Studio: $(printf '%s' "$GRUBSTILL" | tr '\n' ' ' | cut -c1-160)"
fi

# ==========================================================================
# TIER 1a - declared packages are really installed
# ==========================================================================
say "--- tier 1a: declared packages"
DECL="/usr/local/share/puralvos/selftest-packages.txt"

if [ -r "$DECL" ]; then
	NDECL=0; NMISS=0
	while IFS= read -r p; do
		case "$p" in ''|'#'*) continue ;; esac
		NDECL=$((NDECL+1))
		name=${p%%=*}
		[ -z "$name" ] && continue
		state=$(dpkg-query -W -f='${db:Status-Abbrev}' "$name" 2>/dev/null)
		case "$state" in
			"ii "*) ;;
			*) NMISS=$((NMISS+1))
			   result tier1 FAIL "pkg:$name" "declared by the SDK but not installed" ;;
		esac
	done < "$DECL"
	say "INFO checked $NDECL declared packages"
	# Anything that is declared but absent is a build failure, and reporting
	# it as a pile of individual lines hides that.
	[ "$NMISS" -gt 0 ] && result tier1 FAIL "declared-packages-complete" "$NMISS of $NDECL missing"
else
	result tier1 FAIL "declared-packages-complete" "$DECL missing, cannot verify the curated set"
fi

# ==========================================================================
# TIER 1b - every menu entry points at something that exists
# ==========================================================================
say "--- tier 1b: desktop entries"

list_desktops() {
	find /usr/local/share/applications /usr/share/applications \
		"$PurHome"/.local/share/applications \
		-maxdepth 1 -name '*.desktop' 2>/dev/null | sort
}

# Pull the executable out of an Exec= line, from the shared library.
#
# The library lives in tools/lib/ in the repository and is installed into the
# image at /usr/local/lib/puralvos/desktop-exec.sh, and this test runs from
# either place. One parser, both callers: when the build and the test each had
# their own, they disagreed, the test's was wrong about "env -u VAR cmd", and
# it reported OpenLP as broken on an image where OpenLP was fine.
for _lib in /usr/local/lib/puralvos/desktop-exec.sh \
            "$(dirname "$(readlink -f "$0")")/lib/desktop-exec.sh"; do
	[ -r "$_lib" ] && . "$_lib" && break
	_lib=""
done
if [ -z "${_lib:-}" ]; then
	say "RESULT tier1 FAIL selftest-incomplete the desktop-entry library is missing"
fi

# Is a bare binary name runnable? Used by the launch tests. No /usr/games: this
# product ships no games, and that directory is empty in the image.
binary_present() {
	case "$1" in
		/*) [ -x "$1" ] ;;
		*)  command -v "$1" >/dev/null 2>&1 ||
		    { [ -x "/usr/local/bin/$1" ] || [ -x "/usr/bin/$1" ]; } ;;
	esac
}

NDESK=0
for d in $(list_desktops); do
	grep -qE '^Type=Application' "$d" 2>/dev/null || continue
	grep -qE '^Hidden=true' "$d" 2>/dev/null && continue
	grep -qE '^NoDisplay=true' "$d" 2>/dev/null && continue
	grep -qE '^Exec=' "$d" 2>/dev/null || continue
	NDESK=$((NDESK+1))
	name=$(sed -n 's/^Name=\(.*\)$/\1/p' "$d" | head -1)
	[ -z "$name" ] && name=$(basename "$d" .desktop)
	if [ -z "$(desktop_exec "$d")" ]; then
		result tier1 FAIL "desktop:$name" "no Exec found in $d"
		continue
	fi
	# "/" explicitly, and not left to the default. Inside a running image the
	# two are the same thing, but a default that silently changes meaning
	# depending on the caller is how this check ended up asking the build
	# machine about a build tree and hiding all 154 applications in the
	# product. See tools/lib/desktop-exec.sh.
	if ! desktop_exec_present "$d" /; then
		result tier1 FAIL "desktop:$name" \
			"Exec '$(desktop_exec "$d")' not found ($d)"
	fi
done
say "INFO checked $NDESK desktop entries"

# ==========================================================================
# TIER 4 - launch the applications for real
# ==========================================================================
say "--- tier 4: launching applications"

if [ "$XUP" != 1 ]; then
	# Without a display there is no window to wait for, so every launch would
	# time out and every application would be reported broken. That is a false
	# reading of the applications: they are untested, not broken. Say so once,
	# clearly, instead of manufacturing forty failures.
	result tier4 FAIL "applications-launchable" \
		"not tested: there is no X server, so no application could be judged"
	say ""
	say "--- summary"
	say "INFO pass=$PASS fail=$FAIL slow=$SLOW skip=$SKIP"
	say "INFO elapsed=$(( $(date +%s) - T0 ))s"
	if [ ${#FAILED[@]} -gt 0 ]; then
		say "--- problems"
		for f in "${FAILED[@]}"; do say "PROBLEM $f"; done
	fi
	say "########## PURALVOS SELFTEST END ok=$((PASS+SLOW)) bad=$FAIL ##########"
	exit 1
fi

TMPD=$(mktemp -d /tmp/selftest.XXXXXX)

# The whole window tree, so a new top level window can be spotted no matter
# how deep it sits.
#
# Captured before it is filtered. `xwininfo | grep -o | tr | sort` is a
# four-stage pipeline where grep can exit early, and this runs inside a $( ) that
# is compared against a previous result to decide whether an application opened
# a window at all. If the pipeline returns 141 under pipefail, window_sig
# returns an empty or truncated signature, `after != before` becomes a coin
# flip, and tier 4 reports applications as launchable or broken at random.
window_sig() {
	local raw
	raw=$(as_desktop xwininfo -root -children 2>/dev/null || true)
	printf '%s' "$raw" | grep -oE '^\s+0x[0-9a-f]+' | tr -d ' ' | sort
}

LAUNCH_TIMEOUT=${LAUNCH_TIMEOUT:-60}

# Close whatever an application left behind, whether or not it worked.
reap() {
	local bin=$1 pid=$2
	# -x, not -f. A launch test for a wrapper entry (Hexter is "sh -c
	# 'jack-dssi-host ...'") hands reap bin="sh", and pkill -f sh matches
	# every command line containing "sh" - which includes the self test
	# itself ("/bin/bash .../puralvos-selftest") and plasmashell. The first
	# run that reached the Hexter entry killed the test and the desktop with
	# it. -x matches the process name exactly, so reap only ever reaches the
	# shell (or application) that this test actually launched.
	pkill -x "$bin" >/dev/null 2>&1
	kill "$pid" >/dev/null 2>&1
	sleep 1
	kill -9 "$pid" >/dev/null 2>&1
	pkill -9 -x "$bin" >/dev/null 2>&1
}

launch_test() {
	local name=$1 bin=$2; shift 2
	local log="$TMPD/${name//\//_}.log"
	local before after pid i up=0 exited=0

	before=$(window_sig)

	as_desktop "$@" >"$log" 2>&1 &
	pid=$!

	for (( i=0; i<LAUNCH_TIMEOUT; i++ )); do
		sleep 1
		after=$(window_sig)
		if [ -n "$after" ] && [ "$after" != "$before" ]; then
			up=1
			break
		fi
		if ! kill -0 "$pid" 2>/dev/null && ! pgrep -x "$bin" >/dev/null 2>&1; then
			exited=1
			break
		fi
	done

	reap "$bin" "$pid"

	if [ "$up" = 1 ]; then
		if [ "$i" -ge 15 ]; then
			result tier4 SLOW "$name" "window after ${i}s"
		else
			result tier4 PASS "$name" "window after ${i}s"
		fi
		return 0
	fi

	local why
	if [ "$exited" = 1 ]; then
		why="exited immediately: $(tail -n 2 "$log" 2>/dev/null | tr '\n' ' ' | cut -c1-140)"
	else
		why="no window within ${LAUNCH_TIMEOUT}s: $(tail -n 2 "$log" 2>/dev/null | tr '\n' ' ' | cut -c1-140)"
	fi
	result tier4 FAIL "$name" "$why"
	return 1
}

# The curated set from tasks.list, and only that: video.
# Nothing here is a general desktop application, because PuralvOS Video does
# not ship them. A menu entry that tests a stripped application is a false
# failure.
#
# This list mirrors tasks.list. Every entry below is in ubuntustudio-video.
# Audio and graphics applications are deliberately absent: the audio and
# graphics task bundles are removed by tools/build-live.sh, so testing them
# would only produce SKIP lines.
#
# The menu sweep below still walks every remaining application entry, so a
# video tool that is installed but broken is reported even if it is not named
# here.
TESTS=(
# video
"kdenlive:kdenlive"
"blender:blender"
"obs:obs"
"subtitleeditor:subtitleeditor"
"vlc:vlc --intf qt"
"synfig:synfigstudio"
"qprompt:qprompt"
"xjadeo:xjadeo"
"kdenlive-effects:kdenlive"
)

for t in "${TESTS[@]}"; do
	n=${t%%:*}; c=${t#*:}
	bin=${c%% *}
	if ! binary_present "$bin"; then
		result tier4 SKIP "$n" "$bin not installed"
		continue
	fi
	launch_test "$n" "$bin" $c
done

# Everything else the menu offers.
#
# The list above only covers what PuralvOS promises. This walks every
# remaining application entry the image ships and tries it too, so a menu
# item that does not start is reported rather than sitting there looking fine
# until somebody clicks it.
launched=" $(echo "${TESTS[@]}" | tr ' ' '\n' | cut -d: -f1 | tr '\n' ' ') "
for d in $(list_desktops); do
	grep -qE '^Type=Application' "$d" 2>/dev/null || continue
	grep -qE '^Hidden=true' "$d" 2>/dev/null && continue
	grep -qE '^NoDisplay=true' "$d" 2>/dev/null && continue
	grep -qE '^Exec=' "$d" 2>/dev/null || continue
	grep -qE '^Terminal=true' "$d" 2>/dev/null && continue

	name=$(sed -n 's/^Name=\(.*\)$/\1/p' "$d" | head -1)
	[ -z "$name" ] && name=$(basename "$d" .desktop)
	case "$launched" in *" $name "*) continue ;; esac

	bin=$(desktop_exec "$d")
	[ -z "$bin" ] && continue

	if ! binary_present "$bin"; then
		result tier4 SKIP "menu:$name" "$bin not installed"
		continue
	fi

	# Skip the ones that only make sense inside a running session, and the
	# per-soundcard tools. Echnomixer and the HDSP pair are front ends for
	# one specific piece of hardware each and exit on purpose when that card
	# is absent, which is not a fault in the image.
	case "$name" in
		*Discover*|*Software*|*Settings*|*"System Settings"*|*Logout*|*"Log Out"*|\
		*Lock*|*Restart*|*Shutdown*|*Reboot*|*"Screen Saver"*|*Screensaver*|\
		*Kontoche*|*KWallet*|*Print*|*Screenshot*|*Spectacle*|*Help*|*Manual*|\
		*About*|*Info*|*Index*|*Update*|*Search*|*support*|\
		*Echnomixer*|*Envy24*|*HDSPConf*|*HDSPMixer*|\
		*"ImageMagick"*|*"Color depth"*|*"File Manager"*|*"Open Image"*|\
		*Firefox*|*Transmission*)
			result tier4 SKIP "menu:$name" "not a launchable application"
			continue ;;
	esac

	launch_test "menu:$name" "$bin" "$bin"
done

# Console programs. There is no window to wait for and most of them want a
# terminal or arguments, so check that they run and report something sane
# instead of pretending they were broken.
console_test() {
	local name=$1; shift
	local log="$TMPD/${name}.log"
	local rc=0
	as_desktop timeout 10 "$@" >"$log" 2>&1 || rc=$?
	# 124 is the exit status of the timeout itself: the program was still
	# running when its ten seconds were up. For a curses program that is a
	# pass, it drew its interface and had to be killed.
	if [ "$rc" = 0 ]; then
		result tier4 PASS "$name" "runs"
	elif [ "$rc" = 124 ]; then
		result tier4 PASS "$name" "still running after 10s, as expected"
	elif grep -qiE "usage|version|error|cannot|not found" "$log"; then
		result tier4 PASS "$name" "console program responded"
	else
		result tier4 FAIL "$name" \
			"rc=$rc $(tail -n 2 "$log" | tr -d '\033' | tr '\n' ' ' | cut -c1-120)"
	fi
}

# The console programs that belong to the product: video.
#
# The audio and graphics console tools are not part of this image. The menu
# sweep above still reaches any application entry that remains installed.
for t in "ffmpeg:ffmpeg -version" \
	 "ffprobe:ffprobe -version" \
	 "display:display -version"; do
	n=${t%%:*}; c=${t#*:}
	bin=${c%% *}
	if ! binary_present "$bin"; then
		result tier4 SKIP "$n" "$bin not installed"
		continue
	fi
	console_test "$n" $c
done

# --------------------------------------------------------------------------
# summary
# --------------------------------------------------------------------------
say ""
say "--- summary"
say "INFO pass=$PASS fail=$FAIL slow=$SLOW skip=$SKIP"
say "INFO elapsed=$(( $(date +%s) - T0 ))s"
if [ ${#FAILED[@]} -gt 0 ]; then
	say "--- problems"
	for f in "${FAILED[@]}"; do say "PROBLEM $f"; done
fi
say "########## PURALVOS SELFTEST END ok=$((PASS+SLOW)) bad=$FAIL ##########"
rm -rf "$TMPD"
exit 0