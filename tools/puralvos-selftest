say "--- tier 4: launching applications"

if [ "$XUP" != 1 ]; then
	# Without a display there is no window to wait for, so every launch would
	# time out and every application would be reported broken. That is a false
	# reading of the applications: they are untested, not broken. Say so once,
	# clearly, instead of manufacturing forty failures.
	result tier4 FAIL "applications-launchable" \
		"not tested: there is no X server, so no application could be judged"
	say ""
	say "--- summary"
	say "INFO pass=$PASS fail=$FAIL slow=$SLOW skip=$SKIP"
	say "INFO elapsed=$(( $(date +%s) - T0 ))s"
	if [ ${#FAILED[@]} -gt 0 ]; then
		say "--- problems"
		for f in "${FAILED[@]}"; do say "PROBLEM $f"; done
	fi
	say "########## PURALVOS SELFTEST END ok=$((PASS+SLOW)) bad=$FAIL ##########"
	exit 1
fi

TMPD=$(mktemp -d /tmp/selftest.XXXXXX)

# The whole window tree, so a new top level window can be spotted no matter
# how deep it sits.
window_sig() {
	as_desktop xwininfo -root -children 2>/dev/null | grep -oE '^\s+0x[0-9a-f]+' | tr -d ' ' | sort
}

LAUNCH_TIMEOUT=${LAUNCH_TIMEOUT:-60}

# Close whatever an application left behind, whether or not it worked.
reap() {
	local bin=$1 pid=$2
	pkill -f "$bin" >/dev/null 2>&1
	kill "$pid" >/dev/null 2>&1
	sleep 1
	kill -9 "$pid" >/dev/null 2>&1
	pkill -9 -f "$bin" >/dev/null 2>&1
}

launch_test() {
	local name=$1 bin=$2; shift 2
	local log="$TMPD/${name//\//_}.log"
	local before after pid i up=0 exited=0

	before=$(window_sig)

	as_desktop "$@" >"$log" 2>&1 &
	pid=$!

	for (( i=0; i<LAUNCH_TIMEOUT; i++ )); do
		sleep 1
		after=$(window_sig)
		if [ -n "$after" ] && [ "$after" != "$before" ]; then
			up=1
			break
		fi
		if ! kill -0 "$pid" 2>/dev/null && ! pgrep -f "$bin" >/dev/null 2>&1; then
			exited=1
			break
		fi
	done

	reap "$bin" "$pid"

	if [ "$up" = 1 ]; then
		if [ "$i" -ge 15 ]; then
			result tier4 SLOW "$name" "window after ${i}s"
		else
			result tier4 PASS "$name" "window after ${i}s"
		fi
		return 0
	fi

	local why
	if [ "$exited" = 1 ]; then
		why="exited immediately: $(tail -n 2 "$log" 2>/dev/null | tr '\n' ' ' | cut -c1-140)"
	else
		why="no window within ${LAUNCH_TIMEOUT}s: $(tail -n 2 "$log" 2>/dev/null | tr '\n' ' ' | cut -c1-140)"
	fi
	result tier4 FAIL "$name" "$why"
	return 1
}

